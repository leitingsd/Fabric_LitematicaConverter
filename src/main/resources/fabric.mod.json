{
  "schemaVersion": 1,
  "id": "litematicaconversion",
  "version": "1.0.1",
  "name": "Litematica Conversion",
  "description": "A mod that can batch-convert Litematica schematics from version 1.20.5+ (V7) to version 1.20.4 and earlier (V6).\n\nUpstream standalone program: LitematicaConverter [https://github.com/leitingsd/LitematicaConverter]",
  "authors": [
    "Leitingsd"
  ],
  "contact": {
    "sources": "https://github.com/leitingsd/Fabric_LitematicaConverter"
  },
  "license": "LGPLv3",
  "icon": "assets/litematicaconversion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.leitingsd.litematicaconversion.LitematicaConversion"
    ]
  },
  "mixins": [
    "litematicaconversion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.23",
    "fabric": "*",
    "minecraft": "~1.20.4",
    "litematica": ">=0.17.2",
    "malilib": ">=0.18.1"
  }
}
